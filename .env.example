# App
DEBUG=true

# Database (SQLite default, swap to postgresql+asyncpg://user:pass@host/db for prod)
DATABASE_URL=sqlite+aiosqlite:///./ticketpilot.db

# LLM
LLM_API_KEY=sk-your-key-here
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=10
LLM_MAX_RETRIES=2

# Business Logic
AI_CONFIDENCE_THRESHOLD=80

# Security
ADMIN_API_KEY=dev-admin-key-change-in-production
WEBHOOK_API_KEY=dev-webhook-key-change-in-production
